# FastAPI base URL — must match the running backend.
# Localhost dev:
VITE_API_URL=http://localhost:8000

# Supabase URL + anon key for direct REST auth from the side panel.
# Anon key is safe to ship — it's the same key the Next.js app exposes via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Auth still requires email+password.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
