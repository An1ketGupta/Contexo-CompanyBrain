# ════════════════════════════════════════════════════════════
#  Nirnaya IQ — Root Environment Variable Reference
#  Copy to apps/api/.env and apps/web/.env.local, fill values.
# ════════════════════════════════════════════════════════════

# ── AI Providers ─────────────────────────────────────────────
GEMINI_API_KEY=                   # Google AI Studio — free tier
ANTHROPIC_API_KEY=                # Add when switching to paid Claude
OPENAI_API_KEY=                   # Add when switching embeddings to OpenAI

# ── Provider selection ───────────────────────────────────────
LLM_PROVIDER=gemini               # gemini | claude | openai
EMBEDDING_PROVIDER=google         # google | openai
EMBEDDING_DIMENSIONS=768          # 768 for Google, 1536 for OpenAI

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Backend only — NEVER expose to browser

# ── Next.js public vars (safe for browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=              # FastAPI URL (used in client-side code if needed)
API_URL=                          # FastAPI URL — server-side only, used by Next.js API proxy routes

# ── Background jobs ──────────────────────────────────────────
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Caching ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Storage (add when migrating to R2 on paid tier) ──────────
STORAGE_PROVIDER=supabase         # supabase | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── OAuth state secret (used by every integration's CSRF token) ──
OAUTH_STATE_SECRET=                # rotate via env; 32+ random chars

# ── OneDrive / SharePoint (Microsoft Graph) ──────────────────
# Azure AD app, multi-tenant. Scopes requested at install:
#   offline_access Files.Read.All Sites.Read.All User.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common           # "common" for multi-tenant; specific id to pin
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/onedrive/callback

# ── Confluence (Atlassian OAuth 3LO) ─────────────────────────
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/confluence/callback

# ── GitHub App ───────────────────────────────────────────────
# Create at github.com/settings/apps. Required permissions:
#   Contents: Read    Issues: Read    Discussions: Read    Metadata: Read
GITHUB_APP_ID=
GITHUB_APP_SLUG=                  # the public slug, used to build install URL
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key. Encode \n as literal "\n" if storing inline in .env.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/github/callback

# ── Dropbox Business ────────────────────────────────────────
# token_access_type=offline is forced server-side to get refresh tokens.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/dropbox/callback

# ── Jira Cloud (per-org OAuth 3LO) ──────────────────────────────
# Atlassian developer console → OAuth 2.0 (3LO) app.
# Scopes: read:jira-work write:jira-work offline_access read:me
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback
