# ════════════════════════════════════════════════════════════
#  Contexo — Root Environment Variable Reference
#  Copy to apps/api/.env and apps/web/.env.local, fill values.
# ════════════════════════════════════════════════════════════

# ── AI Providers ─────────────────────────────────────────────
GEMINI_API_KEY=                   # Google AI Studio — free tier
ANTHROPIC_API_KEY=                # Add when switching to paid Claude
OPENAI_API_KEY=                   # Add when switching embeddings to OpenAI

# ── Provider selection ───────────────────────────────────────
LLM_PROVIDER=gemini               # gemini | claude | openai
EMBEDDING_PROVIDER=google         # google | openai
EMBEDDING_DIMENSIONS=768          # 768 for Google, 1536 for OpenAI

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # Backend only — NEVER expose to browser

# ── Next.js public vars (safe for browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=              # FastAPI URL (used in client-side code if needed)
API_URL=                          # FastAPI URL — server-side only, used by Next.js API proxy routes

# ── Background jobs ──────────────────────────────────────────
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Caching ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Storage (add when migrating to R2 on paid tier) ──────────
STORAGE_PROVIDER=supabase         # supabase | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── OAuth state secret (used by every integration's CSRF token) ──
OAUTH_STATE_SECRET=                # rotate via env; 32+ random chars

# ── Google (Drive, Gmail, Workspace, support mailbox) ────────
# One OAuth client in https://console.cloud.google.com/apis/credentials.
# EVERY redirect URI below must be registered on that client as an
# "Authorized redirect URI" — each flow needs its own, because the callback
# handler identifies the flow by which URI Google returned to.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/drive/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google-workspace/callback
# Org-level support inbox (gmail.readonly + gmail.send). This is the mailbox
# customers email; it's polled for new tickets and replies send from it.
SUPPORT_MAILBOX_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/support-mailbox/callback

# ── Jira Cloud (per-org OAuth 3LO) ──────────────────────────────
# Atlassian developer console → OAuth 2.0 (3LO) app.
# Scopes: read:jira-work write:jira-work offline_access read:me
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback

# ── Transactional email ─────────────────────────────────────────
# Origin the email templates use to build absolute asset URLs (the brand
# wordmark in the shell header). Mail clients can't resolve relative paths, so
# this must be publicly reachable — point it at the deployed web app, not
# localhost, or the logo will be a broken image in every email.
# Defaults to https://app.nirnayaiq.com when unset.
EMAIL_ASSET_BASE_URL=
