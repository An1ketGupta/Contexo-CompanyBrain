# ── NirnayaIQ self-hosted Documenso — environment ──────────────────────────
# Copy to `.env`, fill in, then: docker compose --env-file .env up -d
# Generate all secrets with: bash scripts/generate-secrets.sh

# ── Postgres (managed — e.g. Neon) ──────────────────────────────────────────
# No local `database` service; Documenso connects straight to a managed
# Postgres instance. Paste your provider's connection string(s) below.
# Pooled connection (e.g. Neon's "-pooler" host) for normal app traffic.
NEXT_PRIVATE_DATABASE_URL=postgresql://user:password@host-pooler.example.com/dbname?sslmode=require
# Direct/unpooled connection, used for migrations. Falls back to the pooled
# URL above if your provider only gives you one string.
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgresql://user:password@host.example.com/dbname?sslmode=require

# ── URLs ───────────────────────────────────────────────────────────────────
# Public URL the browser loads the embedded signer from. Local: the host port
# mapped in docker-compose. Production: your Documenso subdomain.
#   Local:      http://localhost:3030
#   Production:  https://sign.nirnayaiq.com
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3030
DOCUMENSO_HOST_PORT=3030
PORT=3000

# Hosts allowed to receive webhooks despite resolving to a private/loopback
# address. Locally the adapter is only reachable at host.docker.internal, which
# Documenso's SSRF guard blocks by default — without this, every completion
# event fails with "Webhook URL resolves to a private or loopback address" and
# envelopes never leave 'sent'. Leave EMPTY in production.
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=host.docker.internal

# ── Auth / encryption — 32+ chars each; `openssl rand -base64 32` ─────────
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# ── Signing certificate (PAdES) ────────────────────────────────────────────
# Generate cert.p12 next to this file with: bash scripts/generate-cert.sh
# The passphrase you chose there goes here.
NEXT_PRIVATE_SIGNING_PASSPHRASE=change-me-cert-passphrase
# Path on the HOST to the .p12 (mounted read-only into the container).
DOCUMENSO_CERT_PATH=./cert.p12

# ── File storage ───────────────────────────────────────────────────────────
# LOCAL: leave as 'database' (PDFs live in Documenso's Postgres, no S3 needed).
# PRODUCTION (free): point at the Supabase Storage S3-compatible endpoint.
#   Supabase → Project Settings → Storage → S3 Connection gives you the
#   endpoint, region, access key id + secret. Use a DEDICATED bucket for
#   Documenso (do NOT reuse the `document` bucket apps/api ingests into).
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
# NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
# NEXT_PRIVATE_UPLOAD_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# NEXT_PRIVATE_UPLOAD_REGION=<supabase-region e.g. ap-south-1>
# NEXT_PRIVATE_UPLOAD_BUCKET=documenso
# NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
# NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
# NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=true

# ── Email (Resend SMTP relay — same account apps/api sends from) ───────────
# Resend → API Keys gives the password; username is literally "resend".
# FROM address must be on a domain you've verified in Resend.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.resend.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=resend
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_NAME=NirnayaIQ
NEXT_PRIVATE_SMTP_FROM_ADDRESS=onboarding@nirnayaiq.com

# ── After first boot ───────────────────────────────────────────────────────
# 1. Open NEXT_PUBLIC_WEBAPP_URL, create the admin account + a team.
# 2. Team → API Tokens → create one; put it in apps/esign/.env as
#    DOCUMENSO_API_TOKEN.
# 3. Team → Webhooks → add endpoint https://<adapter-host>/webhooks/documenso
#    for DOCUMENT_* events; put its secret in apps/esign/.env as
#    DOCUMENSO_WEBHOOK_SECRET.
