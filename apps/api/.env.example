# ── Fill these in from your Supabase project dashboard ───────────
SUPABASE_URL=

SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ─────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# ── Provider selection ───────────────────────────────────────────
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=google
EMBEDDING_DIMENSIONS=768

# ── App ──────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Storage ──────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase

# ── Background jobs ──────────────────────────────────────────────
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Caching ──────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability ────────────────────────────────────────────────
# Empty SENTRY_DSN disables Sentry — fine for local dev.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Set by CI from the git SHA so Sentry can match source maps to a release.
RELEASE_VERSION=

# "json" in production (Railway captures stdout as JSON); "console" locally.
LOG_FORMAT=console
LOG_LEVEL=INFO

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

# ── Rate limits ──────────────────────────────────────────────────
RATE_LIMIT_CHAT_PER_USER_PER_MINUTE=20
RATE_LIMIT_CHAT_MONTHLY_STARTER=500
RATE_LIMIT_CHAT_MONTHLY_GROWTH=2500

# ── V5 Day 3 — Founder-only internal dashboards ──────────────────
# Comma-separated Supabase auth user UUIDs allowed to hit /internal/*
# (LLM cost dashboard). Empty = nobody passes the gate, route 404s.
FOUNDER_USER_IDS=

# ── V5 Day 3 — Crisp.chat live support widget (NEXT-side public var) ─
# Set in apps/web/.env.local — left here for visibility. Empty disables
# the widget entirely.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ── V5 Day 4 — Embedding fine-tuning (Modal.com serverless GPU) ──
# Modal app deployed from modal_apps/embedding_finetune.py.
# Empty values gate the admin button + skip the Inngest worker cleanly.
MODAL_FINETUNE_ENDPOINT=
MODAL_FINETUNE_STATUS_ENDPOINT=
MODAL_FINETUNE_TOKEN=
EMBEDDING_FINETUNE_MIN_PAIRS=50
EMBEDDING_FINETUNE_RECOMMENDED_PAIRS=200

# ── Jira Cloud (per-org OAuth 3LO) ──────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback

# ── ATS integrations (Greenhouse / Lever / Ashby) ───────────────
# All three ATSes are paid-only with no self-serve developer tier. To
# exercise the recruiting publish loop end-to-end locally without a real
# customer contract, flip the flag below and start the mock server:
#
#   cd apps/api && uv run python -m tools.mock_ats_server
#
# Then in the web UI, connect any ATS with any non-empty API key — the
# mock accepts everything and seeds realistic taxonomy.
USE_MOCK_ATS=false
MOCK_ATS_URL=http://localhost:8001

# Per-provider URL overrides (advanced — leave unset unless you want a
# specific provider to point somewhere other than the real host while the
# others stay real). USE_MOCK_ATS=true wins over these.
# GREENHOUSE_API_URL=https://harvest.greenhouse.io/v1
# LEVER_API_URL=https://api.lever.co/v1
# ASHBY_API_URL=https://api.ashbyhq.com
# NAUKRI_API_URL=https://api.naukri.com/v1
# NAUKRI_WEBHOOK_SECRET=  # reserved for future webhook-signed callbacks

# ── Onboarding v2 (LOI/ BGV / Appointment Letter / NDA / Induction) ──
# Gotenberg sidecar handles DOCX→PDF conversion for HR documents. Run it as
# its own Railway service (image: gotenberg/gotenberg:8) and point this at
# the internal URL. Empty disables the agent (it will surface a clear
# "PDF service not configured" error rather than 500).
GOTENBERG_URL=http://gotenberg:3000

# Optional: override the base URL the BGV reference receives in their email
# link. Defaults to APP_URL. Set this if the public BGV form is hosted on
# a separate subdomain.
# BGV_PUBLIC_URL=

# ── In-house e-sign service (apps/esign) ────────────────────────────────
# Separate FastAPI service (deployed on Render) that signs the onboarding
# LOI/AL/NDA PDFs directly — see apps/esign/. Missing keys disable e-sign
# cleanly; the agent falls back to the print/scan/email flow.
ESIGN_SERVICE_URL=http://localhost:8001
ESIGN_API_KEY=
