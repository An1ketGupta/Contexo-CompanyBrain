# Shared with apps/api — same Supabase project, service-role key bypasses
# RLS the same way apps/api's Inngest functions do.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Inngest account as apps/api. This service only sends events (no
# signing key needed — it never hosts an /api/inngest serve handler).
INNGEST_EVENT_KEY=

# Shared secret — apps/api sends this as X-Esign-Api-Key on every
# /envelopes call. Generate any long random string; must match
# ESIGN_API_KEY in apps/api's .env.
ESIGN_API_KEY=

# Public web app URL — used to build {app_url}/sign/{token} links.
APP_URL=http://localhost:3000

ENVIRONMENT=development
