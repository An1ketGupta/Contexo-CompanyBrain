# Shared with apps/api — same Supabase project, service-role key bypasses
# RLS the same way apps/api's Inngest functions do.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Inngest account as apps/api. This service only sends events (no
# signing key needed — it never hosts an /api/inngest serve handler).
INNGEST_EVENT_KEY=

# Shared secret — apps/api sends this as X-Esign-Api-Key on every
# /envelopes call. Generate any long random string; must match
# ESIGN_API_KEY in apps/api's .env.
ESIGN_API_KEY=

# Public web app URL — used to build {app_url}/sign/{token} links.
APP_URL=http://localhost:3000

# ── Documenso (the signing engine this adapter drives) ─────────────────────
# See services/documenso/README.md for how to obtain these.
# BASE_URL   : server↔server v2 API host (compose service / internal host).
# PUBLIC_URL : browser-facing host the embedded signer iframe loads from.
# API_TOKEN  : Documenso Team API token ("api_...").
# WEBHOOK_SECRET : secret from the Documenso Team → Webhooks config; the
#              /webhooks/documenso receiver verifies inbound calls with it.
DOCUMENSO_BASE_URL=http://localhost:3030
DOCUMENSO_PUBLIC_URL=http://localhost:3030
DOCUMENSO_API_TOKEN=
DOCUMENSO_WEBHOOK_SECRET=
# Optional: only if your API token isn't already team-scoped.
DOCUMENSO_TEAM_ID=

ENVIRONMENT=development
